<Page x:Class="TimeLord_MVVM_Kazakov.View.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="700"
      Title="Main">

    <!-- Было: DataContext="(Binding Stopwatch)" — строка, не биндинг -->
    <Grid Background="#FFE8E100" DataContext="{Binding Stopwatch}">

        <Label Foreground="White" FontSize="48"
               Content="{Binding Timer}"
               Margin="115,10,10,10"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>

        <ListBox ItemsSource="{Binding Interval}"
                 Margin="10,70,0,10"
                 HorizontalAlignment="Left" Width="100">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <!-- Было: Text="(Binding)" — строка, не биндинг -->
                        <TextBlock Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="{Binding TextButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="100" Height="25" Background="White" Margin="10,10,0,0"
                Command="{Binding StartTimer}"/>

        <Button Content="Интервал"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Width="100" Height="25" Background="White" Margin="10,40,0,0"
                Command="{Binding IntervalTimer}"/>
    </Grid>
</Page>